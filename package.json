{
  "name": "llm-models-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "pretest": "npm run build:static",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "pretest:live": "npm run build:static",
    "test:live": "LIVE_TESTS=1 node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --test test/*.test.ts test/*.test.mjs",
    "update:db": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs scripts/update-db.ts",
    "build:static": "tsx scripts/build-static.ts",
    "check:publication": "tsx scripts/check-publication.ts",
    "build:publish": "npm run typecheck && npm run check:publication && npm run build:static",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
